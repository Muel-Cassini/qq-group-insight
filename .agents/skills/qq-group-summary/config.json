  "p0_time_patterns": [
    "@全体成员", "@all", "全体成员", "重要通知", "紧急",
    "今日截止", "今天截止", "明天截止", "截止(时间|日期)?[:：]?\\s*\\d",
    "\\d{1,2}\\s*月\\s*\\d{1,2}\\s*日?\\s*(前|截止)", "今(日|天)(内|之前)", "尽快", "务必"
  ],

  "p0_action_patterns": [
    "投递", "报名", "截止", "提交", "确认", "面试", "笔试", "宣讲会", "截止时间",
    "领取", "填写", "参加", "开通", "缴纳"
  ],

  "p1_patterns": [
    "@我(?![0-9A-Za-z\\u4e00-\\u9fff])",
    "待办", "记得", "麻烦", "帮忙", "帮我", "求(助|教|带|内推)", "回复我",
    "确认一下", "审批", "报名",
    "(请问|问一下|有没有人|谁知道|谁有|求解|求问)[^。！？]{2,}",
    "(什么(原因|情况|问题)|怎么(办|样|弄|做|回事)|为什么|如何|哪里|哪个)[^。！？]{2,}[?？]?",
