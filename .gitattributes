# 统一换行符，避免 Windows/Linux 混用导致的整文件 diff
* text=auto eol=lf

# Windows 脚本必须 CRLF（cmd.exe / PowerShell 更稳）
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 明确标记二进制，避免被当成文本处理
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.xlsx binary
*.docx binary
*.pptx binary
*.zst binary

# 示例数据里的 JSONL 当文本（便于 review）
*.jsonl text eol=lf

# 生成物不要参与语言统计 / diff
*.pyc binary
